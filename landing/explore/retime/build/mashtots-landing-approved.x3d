uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;

uniform sampler2D FLOW;
in vec4 aA; in vec4 aB;
out vec4 vCol; out vec2 vQ; out float vMode;
void main(){
  tl(); float t = t_;
