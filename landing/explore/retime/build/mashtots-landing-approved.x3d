        <field name='LD' type='MFVec4f' accessType='inputOutput' value='561.2 131 -0.8096 0, 347.6 261 -0.6509 5461, 899.3333 261 -0.5897 5461, 570.9333 261 -0.4879 5461, 701.7333 131 -0.6106 0, 602.9333 261 -0.349 5461, 733.7333 131 -0.4672 0, 711.4667 131 -0.3905 0, 650.9333 491 0.1511 16373, 714.2667 287 -0.3763 5461, 692 157 -0.5247 0, 554.9333 287 -0.2706 5481, 915.3333 417 -0.1158 10922, 586.9333 417 0.0002 10922, 947.3333 417 0.0322 10923, 1116.4 417 0.0881 10927, 634.9333 287 0.0568 10923, 1071.8667 287 0.0925 10923, 714.2667 443 -0.0463 10922, 347.6 313 -0.1456 10922, 746.2667 313 -0.0935 10922, 570.9333 313 -0.0275 10922, 778.2667 443 0.1507 10927, 526.4 183 0.0117 16373, 810.2667 543 0.4904 16383, 443.6 443 0.4242 16383, 842.2667 313 0.2977 11263, 522.9333 339 0.0589 10923, 538.9333 469 0.2181 10923, 363.6 339 0.1513 10923, 570.9333 469 0.3528 10943, 586.9333 339 0.3123 11007, 602.9333 569 0.7139 16383, 504.1333 209 0.4146 16381, 443.6 569 0.9382 16383, 995.3333 569 1 16383'/>
