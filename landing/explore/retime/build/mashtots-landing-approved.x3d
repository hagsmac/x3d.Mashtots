        <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;

uniform float etime;      // seconds since load (TimeSensor.elapsedTime); the loop repeats every CYCLER s of real time
uniform float toff;       // seek offset in seconds, set by the page's section tabs
const int NSEG = 24;  // the real-time timeline: segments of real time mapped onto the deck's act time (see timeline.py)
const float RB[25] = float[25](0.00000, 6.15000, 9.15000, 11.15000, 51.95000, 63.69783, 80.69783, 92.69783, 102.69783, 110.77475, 117.10808, 121.81396, 126.25841, 130.46894, 134.46894, 138.46894, 142.96894, 147.46894, 151.96894, 156.96894, 158.30227, 195.80227, 197.80227, 202.65227, 204.25227);
const float SA[24] = float[24](0.00000, 6.15000, 9.15000, 11.15000, 72.35000, 85.86000, 85.86000, 85.86000, 85.86000, 96.36000, 105.86000, 113.86000, 121.86000, 129.86000, 137.86000, 145.86000, 154.86000, 163.86000, 172.86000, 182.86000, 184.86000, 184.86000, 186.86000, 191.71000);
const float SRT[24] = float[24](1.00000, 1.00000, 1.00000, 1.50000, 1.15000, 0.00000, 0.00000, 0.00000, 1.30000, 1.50000, 1.70000, 1.80000, 1.90000, 2.00000, 2.00000, 2.00000, 2.00000, 2.00000, 2.00000, 1.50000, 0.00000, 1.00000, 1.00000, 1.00000);
const float SRE[24] = float[24](1.00000, 1.00000, 1.00000, 1.50000, 1.15000, 0.00000, 0.00000, 0.00000, 1.30000, 1.50000, 1.70000, 1.80000, 1.90000, 2.00000, 2.00000, 2.00000, 2.00000, 2.00000, 2.00000, 1.50000, 0.00000, 1.00000, 1.00000, 1.00000);      // rate at the END of each piece (re-timed build: speed ramps)
const float CYCLER = 204.25226894372136;
const float BAR = 1.875;
const float COL0 = 196.00226894372136, COL1 = 204.05226894372137;
const float VOW0 = -1.0, VOW1 = -1.0;   // the measured-vowels act (a hold inside the spectral cut), real time; -1 = none
const float NUM0 = 80.69782608695652, NUM1 = 92.69782608695652, SHI0 = 92.69782608695652, SHI1 = 102.69782608695652, FIN0 = 158.30226894372137, FIN1 = 195.80226894372137, ORG0 = 177.05226894372137, ORG1 = 188.30226894372137, BEAT = 0.46875;
float warp(float tr, out float hold){
  for (int i = 0; i < NSEG; i++) { if (tr < RB[i + 1] || i == NSEG - 1) { float d = max(RB[i + 1] - RB[i], 1e-4), tau = tr - RB[i];
    hold = (SRT[i] == 0.0 && SRE[i] == 0.0) ? 1.0 : 0.0; return SA[i] + tau * (SRT[i] + 0.5 * (SRE[i] - SRT[i]) * tau / d); } }
  hold = 0.0; return 0.0;
}
