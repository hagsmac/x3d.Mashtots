        <field name='LE' type='MFVec4f' accessType='inputOutput' value='720 379.1071 -0.6623 0, 806.122 268.2487 0.3857 0, 815.8286 284.5279 0.4552 0, 826.1549 304.4522 0.0142 0, 760.6239 458.308 -0.5789 0, 848.4298 373.6578 0.3587 0, 782.7554 511.8854 -0.6262 0, 803.845 514.4848 -0.563 0, 956.0106 471.2714 0.3736 0, 862.7991 282.6471 0.3323 0, 793.9824 398.8561 -0.6292 0, 899.4674 258.4353 0.7279 0, 942.1258 278.8391 0.423 0, 974.4088 297.9738 0.5411 0, 978.6225 318.538 0.4926 0, 988.4896 329.9296 0.5663 0, 984.3419 315.8792 0.1637 0, 984.6196 311.6395 0.6493 0, 983.0335 216.5445 0.5374 0, 967.6165 195.7721 0.5701 0, 978.0484 212.9105 0.5391 0, 994.8553 235.8715 0.3445 0, 1035.1213 290.2666 0.2849 0, 954.273 451.7817 -0.75 0, 1084.4114 412.7719 0.5523 0, 1083.9875 362.914 0.6176 0, 1054.8038 351.5407 0.5447 0, 1022.9889 230.7753 0.6933 0, 1062.6765 253.0775 0.3318 0, 1042.2067 243.472 0.687 0, 1087.5687 298.1497 0.4774 0, 1069.7916 333.5347 0.4437 0, 1126.0894 456.2139 0.5937 0, 1008.9757 545 0.546 0, 1152.0636 528.4747 0.7241 0, 1156.9253 530.847 0.266 0'/>
