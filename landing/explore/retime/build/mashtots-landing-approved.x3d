    <ROUTE fromNode='Boot' fromField='enterTime' toNode='Intro' toField='set_startTime'/>
    <ROUTE fromNode='Boot' fromField='isActive' toNode='Intro' toField='set_enabled'/>
  </Scene>
</X3D>
