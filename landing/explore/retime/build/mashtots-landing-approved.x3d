  vCol = vec4(col, min(1.0, (0.05 + 0.6 * v) * (hot ? 1.9 : 1.0)) * spaceK * k);
  gl_PointSize = max(1.0, (hot ? 4.4 : 3.0) * k * float(x3d_Viewport.z) / 1920.0);
  gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * CAM * vec4(W(vec2(TVX + xr * k, TVY + yr * k), 0.02), 1.0); if (vCol.a < 0.003) gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
}
